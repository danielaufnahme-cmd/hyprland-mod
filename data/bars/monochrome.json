        },
        {
          "type": "window",
          "options": {}
        }
      ],
      "center": [],
      "right": [
        {
          "type": "cpu",
          "options": {}
        },
        {
          "type": "memory",
          "options": {}
        },
        {
          "type": "pulseaudio",
          "options": {}
        },
        {
          "type": "battery",
          "options": {}
        },
        {
