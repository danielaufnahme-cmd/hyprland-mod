{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "cyber-mint",
  "name": "Cyber Mint",
  "author": "Hyprland Mod",
  "description": "Near-black windows with a sharp mint and aqua glow.",
  "tags": [
    "dark",
    "colorful",
    "animated"
  ],
  "order": 24,
  "settings": {
    "general:gaps_in": "5",
    "general:gaps_out": "12",
    "general:border_size": "2",
    "general:col.active_border": "rgba(3dffc0ff) rgba(00c2ffff) 90deg",
    "general:col.inactive_border": "rgba(14332cff)",
    "decoration:rounding": "4",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "false",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "20",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(3dffc055)",
    "decoration:shadow:offset": "0 0",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "snap, 0.2, 1, 0.3, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 3, snap, popin 90%",
      "fade, 1, 2.5, snap",
      "layers, 1, 2.5, snap, fade",
      "workspaces, 1, 3, snap, slide",
      "border, 1, 3, snap"
    ]
  },
  "preview": {
    "wallpaper": [
      "#07100e",
      "#0e2a25"
    ],
    "window": "#0a1412"
  }
}
