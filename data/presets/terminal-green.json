{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "terminal-green",
  "name": "Terminal Green",
  "author": "Hyprland Mod",
  "description": "Phosphor-green on black, square and utilitarian.",
  "tags": [
    "dark",
    "sharp",
    "minimal"
  ],
  "order": 29,
  "settings": {
    "general:gaps_in": "2",
    "general:gaps_out": "5",
    "general:border_size": "2",
    "general:col.active_border": "rgba(33ff66ff)",
    "general:col.inactive_border": "rgba(0f3d1aff)",
    "decoration:rounding": "0",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "false",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "false",
    "decoration:shadow:range": "14",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(00000066)",
    "decoration:shadow:offset": "0 3",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "linear, 0, 0, 1, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 3, linear, slide",
      "fade, 1, 2, linear",
      "layers, 1, 2.5, linear, slide",
      "workspaces, 1, 3, linear, slide",
      "border, 1, 2, linear"
    ]
  },
  "preview": {
    "wallpaper": [
      "#020a04",
      "#0a1f0e"
    ],
    "window": "#030d05"
  }
}
