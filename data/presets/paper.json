{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "paper",
  "name": "Paper",
  "author": "Hyprland Mod",
  "description": "Flat and bright like a printed page: no blur, hairline borders, tiny shadows.",
  "tags": [
    "light",
    "minimal"
  ],
  "order": 20,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "12",
    "general:border_size": "1",
    "general:col.active_border": "rgba(2b2b2bff)",
    "general:col.inactive_border": "rgba(d6d2c8ff)",
    "decoration:rounding": "2",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "false",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "6",
    "decoration:shadow:render_power": "2",
    "decoration:shadow:color": "rgba(00000022)",
    "decoration:shadow:offset": "0 1",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "soft, 0.4, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 4, soft, popin 96%",
      "fade, 1, 4, soft",
      "layers, 1, 4, soft, fade",
      "workspaces, 1, 4, soft, fade",
      "border, 1, 5, soft"
    ]
  },
  "preview": {
    "wallpaper": [
      "#f5f3ee",
      "#e8e4da"
    ],
    "window": "#fbfaf7"
  }
}
