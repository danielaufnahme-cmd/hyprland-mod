{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "rose-pine-dawn",
  "name": "Rosé Pine Dawn",
  "author": "Hyprland Mod",
  "description": "A light, airy morning palette: rose and gold borders over warm paper.",
  "tags": [
    "light",
    "warm",
    "theme"
  ],
  "order": 7,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "14",
    "general:border_size": "2",
    "general:col.active_border": "rgba(d7827eff) rgba(ea9d34ff) 45deg",
    "general:col.inactive_border": "rgba(dfdad9ff)",
    "decoration:rounding": "14",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.97",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.2",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "18",
    "decoration:shadow:render_power": "2",
    "decoration:shadow:color": "rgba(57527926)",
    "decoration:shadow:offset": "0 4",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "easeOutExpo, 0.16, 1, 0.3, 1",
      "soft, 0.4, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "border, 1, 8, soft",
      "windows, 1, 5, easeOutExpo",
      "windowsIn, 1, 5, easeOutExpo, popin 85%",
      "windowsOut, 1, 3, soft, popin 85%",
      "fade, 1, 4, soft",
      "layers, 1, 4, easeOutExpo, fade",
      "workspaces, 1, 5, easeOutExpo, slidefade 20%"
    ]
  },
  "preview": {
    "wallpaper": [
      "#faf4ed",
      "#f2e9e1",
      "#ebbcba"
    ],
    "window": "#fffaf3"
  }
}
