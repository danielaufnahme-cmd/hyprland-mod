{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "bubbly",
  "name": "Bubbly",
  "author": "Hyprland Mod",
  "description": "Big round corners, roomy gaps, peachy gradients and springy, bouncy animations.",
  "tags": [
    "colorful",
    "playful",
    "animated",
    "light"
  ],
  "order": 10,
  "settings": {
    "general:gaps_in": "12",
    "general:gaps_out": "28",
    "general:border_size": "3",
    "general:col.active_border": "rgba(ff9e7aff) rgba(ffd36eff) 45deg",
    "general:col.inactive_border": "rgba(ffffff55)",
    "decoration:rounding": "26",
    "decoration:rounding_power": "3",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.94",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "8",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.2",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "28",
    "decoration:shadow:render_power": "2",
    "decoration:shadow:color": "rgba(5a2d1a40)",
    "decoration:shadow:offset": "0 8",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "overshot, 0.34, 1.56, 0.64, 1",
      "bounce, 0.3, 1.4, 0.5, 1",
      "smooth, 0.4, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 5, overshot",
      "windowsIn, 1, 5, overshot, popin 60%",
      "windowsOut, 1, 3.5, smooth, popin 70%",
      "windowsMove, 1, 5, bounce",
      "fade, 1, 4, smooth",
      "layers, 1, 4.5, overshot, popin 80%",
      "workspaces, 1, 5.5, bounce, slide",
      "border, 1, 6, smooth"
    ]
  },
  "preview": {
    "wallpaper": [
      "#ffb88c",
      "#ff8f8f",
      "#ffd36e"
    ],
    "window": "#fff7f0"
  }
}
