{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "soft-pastel",
  "name": "Soft Pastel",
  "author": "Hyprland Mod",
  "description": "Candy-light colours, very round corners and gentle bounce.",
  "tags": [
    "light",
    "colorful",
    "playful",
    "animated"
  ],
  "order": 26,
  "settings": {
    "general:gaps_in": "10",
    "general:gaps_out": "22",
    "general:border_size": "3",
    "general:col.active_border": "rgba(ffb3c7ff) rgba(b8e0ffff) rgba(c7f2d0ff) 45deg",
    "general:col.inactive_border": "rgba(ffffff99)",
    "decoration:rounding": "22",
    "decoration:rounding_power": "3",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.95",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "26",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(7a6a8a2e)",
    "decoration:shadow:offset": "0 8",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "overshot, 0.34, 1.4, 0.64, 1",
      "smooth, 0.4, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 5, overshot",
      "windowsIn, 1, 5, overshot, popin 70%",
      "windowsOut, 1, 3.5, smooth, popin 75%",
      "fade, 1, 4, smooth",
      "layers, 1, 4.5, overshot, popin 80%",
      "workspaces, 1, 5, overshot, slide",
      "border, 1, 6, smooth"
    ]
  },
  "preview": {
    "wallpaper": [
      "#ffd6e0",
      "#c3f0ca",
      "#cde7ff"
    ],
    "window": "#fffafc"
  }
}
