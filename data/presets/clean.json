{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "clean",
  "name": "Clean",
  "author": "Hyprland Mod",
  "description": "Calm blue focus, soft corners and quiet motion. A tidy everyday default.",
  "tags": [
    "minimal",
    "dark",
    "subtle"
  ],
  "order": 0,
  "settings": {
    "general:gaps_in": "4",
    "general:gaps_out": "10",
    "general:border_size": "2",
    "general:col.active_border": "rgba(3584e4ff)",
    "general:col.inactive_border": "rgba(59595966)",
    "decoration:rounding": "10",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "12",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(00000040)",
    "decoration:shadow:offset": "0 2",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "easeOutQuint, 0.23, 1, 0.32, 1",
      "quick, 0.15, 0, 0.1, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "border, 1, 5, easeOutQuint",
      "windows, 1, 4, easeOutQuint",
      "windowsIn, 1, 4, easeOutQuint, popin 90%",
      "windowsOut, 1, 2, quick, popin 90%",
      "fade, 1, 3, quick",
      "layers, 1, 3.5, easeOutQuint",
      "workspaces, 1, 3, easeOutQuint, slide"
    ]
  },
  "preview": {
    "wallpaper": [
      "#1d2b3a",
      "#2c4a5e"
    ],
    "window": "#1e2228"
  }
}
