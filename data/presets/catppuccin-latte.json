{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "catppuccin-latte",
  "name": "Catppuccin Latte",
  "author": "Hyprland Mod",
  "description": "Creamy light theme with soft blue and teal borders and gentle, airy motion.",
  "tags": [
    "light",
    "cool",
    "theme"
  ],
  "order": 12,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "14",
    "general:border_size": "2",
    "general:col.active_border": "rgba(1e66f5ff) rgba(179299ff) 45deg",
    "general:col.inactive_border": "rgba(bcc0ccff)",
    "decoration:rounding": "12",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.97",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "1",
    "decoration:blur:vibrancy": "0.1",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "18",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(4c4f6933)",
    "decoration:shadow:offset": "0 4",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "gentle, 0.3, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 6, gentle, popin 88%",
      "fade, 1, 5, gentle",
      "layers, 1, 5, gentle, fade",
      "workspaces, 1, 6, gentle, slidefade 15%",
      "border, 1, 8, gentle"
    ]
  },
  "preview": {
    "wallpaper": [
      "#eff1f5",
      "#ccd0da"
    ],
    "window": "#eff1f5"
  }
}
