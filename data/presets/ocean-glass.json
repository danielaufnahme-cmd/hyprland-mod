{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "ocean-glass",
  "name": "Ocean Glass",
  "author": "Hyprland Mod",
  "description": "Translucent windows floating over a deep blue-green sea.",
  "tags": [
    "blur",
    "dark",
    "cool",
    "animated"
  ],
  "order": 23,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "16",
    "general:border_size": "1",
    "general:col.active_border": "rgba(7df9ff99) rgba(00b7c233) 45deg",
    "general:col.inactive_border": "rgba(ffffff12)",
    "decoration:rounding": "18",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "0.84",
    "decoration:inactive_opacity": "0.74",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "12",
    "decoration:blur:passes": "4",
    "decoration:blur:vibrancy": "0.35",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "32",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(00172e66)",
    "decoration:shadow:offset": "0 8",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "glide, 0.25, 0.8, 0.25, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 4.5, glide, slide",
      "fade, 1, 3.5, glide",
      "layers, 1, 4, glide, slide",
      "workspaces, 1, 5, glide, slidevert",
      "border, 1, 5, glide"
    ]
  },
  "preview": {
    "wallpaper": [
      "#03256c",
      "#1768ac",
      "#06bee1"
    ],
    "window": "#0b2a3f"
  }
}
