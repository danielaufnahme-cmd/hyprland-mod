{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "material-ocean",
  "name": "Material Ocean",
  "author": "Hyprland Mod",
  "description": "Deep blue-black Material palette with cyan highlights.",
  "tags": [
    "dark",
    "cool",
    "theme"
  ],
  "order": 19,
  "settings": {
    "general:gaps_in": "5",
    "general:gaps_out": "12",
    "general:border_size": "2",
    "general:col.active_border": "rgba(89ddffff) rgba(82aaffff) 45deg",
    "general:col.inactive_border": "rgba(292d3eff)",
    "decoration:rounding": "12",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "3",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "22",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(00000099)",
    "decoration:shadow:offset": "0 3",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "snap, 0.2, 1, 0.3, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 3, snap, popin 90%",
      "fade, 1, 2.5, snap",
      "layers, 1, 2.5, snap, fade",
      "workspaces, 1, 3, snap, slide",
      "border, 1, 3, snap"
    ]
  },
  "preview": {
    "wallpaper": [
      "#0f111a",
      "#1a1c25",
      "#292d3e"
    ],
    "window": "#0f111a"
  }
}
