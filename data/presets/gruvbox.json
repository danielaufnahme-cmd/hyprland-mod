{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "gruvbox",
  "name": "Gruvbox",
  "author": "Hyprland Mod",
  "description": "Retro-warm amber and orange borders, crisp corners and no blur.",
  "tags": [
    "dark",
    "warm",
    "theme"
  ],
  "order": 4,
  "settings": {
    "general:gaps_in": "4",
    "general:gaps_out": "10",
    "general:border_size": "3",
    "general:col.active_border": "rgba(d79921ff) rgba(d65d0eff) 90deg",
    "general:col.inactive_border": "rgba(504945ff)",
    "decoration:rounding": "4",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "false",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "1",
    "decoration:blur:vibrancy": "0.0",
    "decoration:blur:noise": "0.0",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "8",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(1d2021cc)",
    "decoration:shadow:offset": "0 2",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "true",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "ease, 0.25, 0.1, 0.25, 1",
      "easeOut, 0, 0, 0.58, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "border, 1, 6, ease",
      "windows, 1, 4.5, easeOut",
      "windowsIn, 1, 4.5, easeOut, popin 92%",
      "windowsOut, 1, 3, ease, popin 92%",
      "fade, 1, 3.5, ease",
      "layers, 1, 4, easeOut, fade",
      "workspaces, 1, 4, easeOut, slide"
    ]
  },
  "preview": {
    "wallpaper": [
      "#282828",
      "#504945"
    ],
    "window": "#282828"
  }
}
