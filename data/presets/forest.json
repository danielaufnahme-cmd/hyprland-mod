{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "forest",
  "name": "Forest",
  "author": "Hyprland Mod",
  "description": "Deep mossy greens, rounded corners and slow, natural motion.",
  "tags": [
    "dark",
    "green",
    "colorful"
  ],
  "order": 22,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "14",
    "general:border_size": "2",
    "general:col.active_border": "rgba(8fbf7fff) rgba(c9d99aff) 45deg",
    "general:col.inactive_border": "rgba(2c4a39ff)",
    "decoration:rounding": "14",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "1.0",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "6",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.17",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "22",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(06140ccc)",
    "decoration:shadow:offset": "0 3",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "gentle, 0.3, 0, 0.2, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "windows, 1, 6, gentle, popin 88%",
      "fade, 1, 5, gentle",
      "layers, 1, 5, gentle, fade",
      "workspaces, 1, 6, gentle, slidefade 15%",
      "border, 1, 8, gentle"
    ]
  },
  "preview": {
    "wallpaper": [
      "#0f2a1c",
      "#1f4d34",
      "#3b7a57"
    ],
    "window": "#13241b"
  }
}
