{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "tokyo-night",
  "name": "Tokyo Night",
  "author": "Hyprland Mod",
  "description": "City-light blue and cyan glow on deep navy, with translucent unfocused windows.",
  "tags": [
    "dark",
    "cool",
    "blur",
    "theme"
  ],
  "order": 5,
  "settings": {
    "general:gaps_in": "5",
    "general:gaps_out": "14",
    "general:border_size": "2",
    "general:col.active_border": "rgba(7aa2f7ff) rgba(2ac3deff) 45deg",
    "general:col.inactive_border": "rgba(292e42ff)",
    "decoration:rounding": "10",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.92",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "8",
    "decoration:blur:passes": "3",
    "decoration:blur:vibrancy": "0.2",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "20",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(00000077)",
    "decoration:shadow:offset": "0 4",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "easeOutQuint, 0.23, 1, 0.32, 1",
      "quick, 0.15, 0, 0.1, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "border, 1, 5, easeOutQuint",
      "windows, 1, 4, easeOutQuint",
      "windowsIn, 1, 4, easeOutQuint, popin 90%",
      "windowsOut, 1, 2, quick, popin 90%",
      "fade, 1, 3, quick",
      "layers, 1, 3.5, easeOutQuint",
      "workspaces, 1, 3, easeOutQuint, slide"
    ]
  },
  "preview": {
    "wallpaper": [
      "#1a1b26",
      "#24283b",
      "#2ac3de"
    ],
    "window": "#1a1b26"
  }
}
