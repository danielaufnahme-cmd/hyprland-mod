{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "neon",
  "name": "Neon",
  "author": "Hyprland Mod",
  "description": "Electric cyan-to-lime gradient borders that spin, a glow shadow and snappy motion.",
  "tags": [
    "colorful",
    "dark",
    "animated"
  ],
  "order": 9,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "14",
    "general:border_size": "3",
    "general:col.active_border": "rgba(00e5ffff) rgba(00ff9cff) rgba(f9f871ff) 45deg",
    "general:col.inactive_border": "rgba(1f2933ff)",
    "decoration:rounding": "8",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "1.0",
    "decoration:inactive_opacity": "0.9",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "8",
    "decoration:blur:passes": "2",
    "decoration:blur:vibrancy": "0.25",
    "decoration:blur:noise": "0.0117",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "24",
    "decoration:shadow:render_power": "2",
    "decoration:shadow:color": "rgba(00e5ff59)",
    "decoration:shadow:offset": "0 0",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "true",
    "decoration:dim_strength": "0.25",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "snap, 0.2, 1.25, 0.4, 1",
      "sharp, 0.6, 0, 0.1, 1",
      "linear, 0, 0, 1, 1"
    ],
    "animation": [
      "global, 1, 6, default",
      "windows, 1, 2.5, snap",
      "windowsIn, 1, 2.5, snap, popin 80%",
      "windowsOut, 1, 1.8, sharp, popin 80%",
      "fade, 1, 2, sharp",
      "layers, 1, 2.5, snap, slide",
      "workspaces, 1, 2.5, snap, slidevert",
      "border, 1, 3, sharp",
      "borderangle, 1, 40, linear, loop"
    ]
  },
  "preview": {
    "wallpaper": [
      "#05070a",
      "#0b1d2a",
      "#003a3f"
    ],
    "window": "#0a0f14"
  }
}
