{
  "format": "hyprland-mod-preset",
  "version": 1,
  "id": "frost",
  "name": "Frost",
  "author": "Hyprland Mod",
  "description": "Bright icy glass with heavy blur and pale borders.",
  "tags": [
    "light",
    "blur",
    "cool"
  ],
  "order": 28,
  "settings": {
    "general:gaps_in": "6",
    "general:gaps_out": "14",
    "general:border_size": "2",
    "general:col.active_border": "rgba(ffffffcc) rgba(9cc9ee99) 45deg",
    "general:col.inactive_border": "rgba(ffffff55)",
    "decoration:rounding": "16",
    "decoration:rounding_power": "2",
    "decoration:active_opacity": "0.82",
    "decoration:inactive_opacity": "0.72",
    "decoration:blur:enabled": "true",
    "decoration:blur:size": "14",
    "decoration:blur:passes": "4",
    "decoration:blur:vibrancy": "0.25",
    "decoration:blur:noise": "0.02",
    "decoration:shadow:enabled": "true",
    "decoration:shadow:range": "26",
    "decoration:shadow:render_power": "3",
    "decoration:shadow:color": "rgba(3a5a7a33)",
    "decoration:shadow:offset": "0 3",
    "decoration:shadow:sharp": "false",
    "decoration:dim_inactive": "false",
    "decoration:dim_strength": "0.2",
    "animations:enabled": "true"
  },
  "lists": {
    "bezier": [
      "ease, 0.25, 0.1, 0.25, 1",
      "easeOut, 0, 0, 0.58, 1"
    ],
    "animation": [
      "global, 1, 10, default",
      "border, 1, 6, ease",
      "windows, 1, 4.5, easeOut",
      "windowsIn, 1, 4.5, easeOut, popin 92%",
      "windowsOut, 1, 3, ease, popin 92%",
      "fade, 1, 3.5, ease",
      "layers, 1, 4, easeOut, fade",
      "workspaces, 1, 4, easeOut, slide"
    ]
  },
  "preview": {
    "wallpaper": [
      "#dbe9f4",
      "#a9c9e2",
      "#eef5fb"
    ],
    "window": "#f4f9fd"
  }
}
